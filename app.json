{
  "expo": {
    "name": "Samaj Setu",
    "slug": "samaj-setu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "samajsetu",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C62828"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rammandir.samajsetu",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Samaj Setu needs camera access to attach photos to your issue report.",
        "NSPhotoLibraryUsageDescription": "Samaj Setu needs photo library access to attach images to your report.",
        "NSMicrophoneUsageDescription": "Samaj Setu needs microphone access to record audio for your report.",
        "NSLocationWhenInUseUsageDescription": "Samaj Setu uses your location to attach it to your issue report.",
        "NSLocationAlwaysUsageDescription": "Samaj Setu uses your location for issue reporting."
      }
    },
    "android": {
      "package": "com.rammandir.samajsetu",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#C62828"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C62828",
          "sounds": []
        }
      ],
      "expo-audio"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1088c314-0510-4361-a4d8-cd1cecf8eaf2"
    },
    "extra": {
      "eas": {
        "projectId": "1088c314-0510-4361-a4d8-cd1cecf8eaf2"
      }
    },
    "owner": "raushan_expo"
  }
}
